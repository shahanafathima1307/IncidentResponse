# Application Configuration
APP_NAME="Incident Response Agent Backend"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# SQLite Storage Path (relative to project root or absolute)
DATABASE_PATH="backend/data/incidents.db"

# Teammate Integration URLs
# Leave empty until teammates deploy their respective services
AGENT_SERVICE_URL=""          # RocketRide + Groq agent service (e.g. http://localhost:8001)
HINDSIGHT_SERVICE_URL=""      # Hindsight memory service (e.g. http://localhost:8002)
HYDRADB_SERVICE_URL=""        # HydraDB knowledge service (e.g. http://localhost:8003)

# Official Hindsight Engine Settings
HINDSIGHT_API_URL="http://localhost:8888"        # Hindsight Docker server base URL
HINDSIGHT_BANK_ID="incident-response-bank"      # Hindsight memory bank identifier
HINDSIGHT_API_KEY=""                            # Optional API key for Hindsight authentication

# Timeout in seconds for integration HTTP requests
REQUEST_TIMEOUT_SECONDS=5.0

